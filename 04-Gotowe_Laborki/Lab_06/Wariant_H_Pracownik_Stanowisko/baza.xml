<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="relacja.xsl"?>
<!DOCTYPE baza [
<!ELEMENT baza (pracownicy, stanowiska, pracowanie)>
<!ELEMENT pracownicy (pracownik+)>
<!ELEMENT pracownik (imie, nazwisko, wiek)>
<!ATTLIST pracownik id ID #REQUIRED>
<!ELEMENT imie (#PCDATA)>
<!ELEMENT nazwisko (#PCDATA)>
<!ELEMENT wiek (#PCDATA)>
<!ELEMENT stanowiska (stanowisko+)>
<!ELEMENT stanowisko (nazwa, pensja, dzial)>
<!ATTLIST stanowisko id ID #REQUIRED>
<!ELEMENT nazwa (#PCDATA)>
<!ELEMENT pensja (#PCDATA)>
<!ELEMENT dzial (#PCDATA)>
<!ELEMENT pracowanie (pracuje+)>
<!ELEMENT pracuje (lata, miesiace)>
<!ATTLIST pracuje id ID #REQUIRED>
<!ATTLIST pracuje ref1 IDREF #REQUIRED>
<!ATTLIST pracuje ref2 IDREF #REQUIRED>
<!ELEMENT lata (#PCDATA)>
<!ELEMENT miesiace (#PCDATA)>
]>
<baza>
