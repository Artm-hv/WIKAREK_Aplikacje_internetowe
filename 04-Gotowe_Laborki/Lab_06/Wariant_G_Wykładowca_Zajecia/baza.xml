<!ATTLIST przydzial id ID #REQUIRED>
<!ATTLIST przydzial ref1 IDREF #REQUIRED>
<!ATTLIST przydzial ref2 IDREF #REQUIRED>
<!ELEMENT dzien (#PCDATA)>
<!ELEMENT godzina (#PCDATA)>
]>
