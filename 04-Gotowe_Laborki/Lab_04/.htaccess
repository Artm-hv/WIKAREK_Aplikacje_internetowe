# Zabezpieczenie danych osobowych (PESEL) oraz pliku licznika przed bezposrednim pobraniem przez HTTP
<FilesMatch "^(z_.*\.txt|licznik\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
